NODE_ENV=development
PORT=8080

# The Google OAuth client ID used by the browser and by server-side token verification.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Comma-separated browser origins. Do not use * in production.
ALLOWED_ORIGINS=http://localhost:5500,http://localhost:3000,https://your-frontend.example.com

# Keep the Gemini key only on the server. Rotate any key that was previously deployed.
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-2.0-flash

# Optional JSON array of TURN/STUN servers supplied by your TURN provider.
# Example: [{"urls":"stun:stun.l.google.com:19302"}]
ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]
ICE_TRANSPORT_POLICY=all

MAX_PARTICIPANTS=25
ROOM_IDLE_TIMEOUT_MS=86400000
DISCONNECT_GRACE_MS=30000
